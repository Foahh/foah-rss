# Public HTTPS host served by the external reverse proxy.
RSS_DOMAIN=rss.example.com

# Runtime images.
MINIFLUX_VERSION=2.3.1
POSTGRES_VERSION=18

# Database credentials. Generate a long random password before deploying.
POSTGRES_DB=miniflux
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# First boot bootstrap account. After the first successful login, set
# MINIFLUX_CREATE_ADMIN=0 and redeploy.
MINIFLUX_CREATE_ADMIN=1
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=change-me-to-a-long-random-value

# Self-use defaults.
MINIFLUX_POLLING_FREQUENCY=30
MINIFLUX_BATCH_SIZE=50
MINIFLUX_POLLING_LIMIT_PER_HOST=2

# pgBackRest backups. Use a separate bucket/prefix for this service.
PGBACKREST_ENABLED=1
PGBACKREST_STANZA=foah_rss
BACKUP_S3_BUCKET=foah-rss-backups
BACKUP_S3_ACCESS_KEY_ID=change-me
BACKUP_S3_SECRET_ACCESS_KEY=change-me
BACKUP_S3_ENDPOINT=s3.amazonaws.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_URI_STYLE=host
BACKUP_REPO_PATH=/foah-rss
BACKUP_CIPHER_TYPE=aes-256-cbc
BACKUP_CIPHER_PASS=change-me-strong-passphrase
BACKUP_RETENTION_FULL=4
BACKUP_PROCESS_MAX=2

TZ=UTC
